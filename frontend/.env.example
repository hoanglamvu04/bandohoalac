VITE_API_URL=http://localhost:5003/api

# GOOGLE MAPS PRIMARY BASEMAP
# Required for /map after the Google Maps migration.
# Enable "Maps JavaScript API" in Google Cloud Console and restrict the key
# to your localhost / production domains.
VITE_GOOGLE_MAPS_API_KEY=
# Optional cloud Map ID for Google vector styling. Leave blank to use the
# default Google map styling.
VITE_GOOGLE_MAP_ID=

# LONG-TERM PRIMARY BASEMAP
# Point this to your self-hosted MapLibre style generated from local vector
# tiles / PMTiles infrastructure. When present, it becomes the primary map.
# Example: https://maps.example.com/styles/hola/style.json
VITE_LOCAL_STYLE_URL=

# Lightweight local XYZ fallback (raster or tiles rendered by your tile server).
# Example: https://maps.example.com/tiles/{z}/{x}/{y}.webp
VITE_LOCAL_TILE_URL=
# Set 512 when your self-hosted tile server serves retina/512px tiles.
VITE_LOCAL_TILE_SIZE=256

# Temporary cloud provider while the local basemap is being prepared.
VITE_MAPTILER_KEY=
VITE_MAPTILER_MAP_ID=streets-v4
