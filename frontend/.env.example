VITE_API_URL=http://localhost:5003/api

# Preferred production mode: your own LOCAL tile endpoint.
# It may be a self-hosted XYZ/MBTiles proxy clipped to Hola Maps coverage.
# Example: https://maps.example.com/tiles/{z}/{x}/{y}.webp
VITE_LOCAL_TILE_URL=

# Temporary cloud tile provider when local tiles are not ready.
# Requests are still bounded by the nine Hola Maps service patches.
VITE_MAPTILER_KEY=
VITE_MAPTILER_MAP_ID=streets-v4
