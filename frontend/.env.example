VITE_API_URL=http://localhost:5003/api

# LOCAL VECTOR BASEMAP (always preferred for normal map modes)
# These defaults are also hard-coded in localBasemap.js, but keeping them here
# makes the intended runtime configuration explicit.
VITE_PMTILES_URL=/maps/hoalac.pmtiles
VITE_BUILDINGS_PMTILES_URL=/maps/hoalac-buildings.pmtiles

# MAPTILER
# Used for Satellite/Hybrid imagery when configured.
# It does NOT replace the local PMTiles/Overture vector basemap.
# VITE_MAPTILER_KEY=your_maptiler_key
VITE_MAPTILER_MAP_ID=streets-v4

# SATELLITE / HYBRID BASEMAP
# Provider is explicit so a MapTiler key does not silently replace the imagery.
# Supported built-ins: esri | maptiler | mapbox
# Default: esri
VITE_SATELLITE_PROVIDER=esri
# Choose one when you want another provider:
# VITE_SATELLITE_PROVIDER=maptiler
# VITE_SATELLITE_PROVIDER=mapbox
#
# Required only for Mapbox Satellite:
# VITE_MAPBOX_TOKEN=your_public_mapbox_access_token
# VITE_SATELLITE_TILE_URL=https://your-provider.example/{z}/{x}/{y}.jpg
# VITE_SATELLITE_TILE_SIZE=256
# VITE_SATELLITE_ATTRIBUTION=Imagery attribution text

# GOOGLE MAPS (optional / currently not used by the MapLibre renderer)
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
# VITE_GOOGLE_MAP_ID=

# NOTE:
# VITE_MAP_STYLE_URL is a legacy setting and is not used by the current
# MapLibre + local PMTiles renderer. Do not use it to select the main basemap.
