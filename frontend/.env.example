VITE_API_URL=http://localhost:5003/api

# Fast production basemap via MapTiler Cloud.
# Create a key at https://cloud.maptiler.com/ and restrict it to your domains.
VITE_MAPTILER_KEY=
VITE_MAPTILER_MAP_ID=streets-v4

# Optional custom MapLibre style. Used only when VITE_MAPTILER_KEY is empty.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
