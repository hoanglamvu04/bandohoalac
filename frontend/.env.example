VITE_API_URL=http://localhost:5003/api

# LOCAL PMTILES BASEMAP
# Default: /maps/hoalac.pmtiles from frontend/public/maps.
# You can also point this to a PMTiles file hosted on your own VPS/CDN.
VITE_PMTILES_URL=/maps/hoalac.pmtiles

# OPTIONAL SUPPLEMENTAL BUILDING FOOTPRINTS
# Generated by scripts/get-hoalac-buildings.ps1 from Overture Maps Buildings.
# If this file exists, Hola Maps automatically replaces the sparse OSM building
# fill at local zooms with the denser Overture building layer.
VITE_BUILDINGS_PMTILES_URL=/maps/hoalac-buildings.pmtiles
