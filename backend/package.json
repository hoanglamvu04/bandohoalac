{
  "name": "hola-maps-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/scripts/backupDatabase.js --optional && node src/database/migrate.js",
    "db:migrate:seed": "node src/database/migrate.js --seed",
    "db:backup": "node src/scripts/backupDatabase.js",
    "db:seed": "node src/database/seed.js",
    "test": "node --test tests/*.test.js",
    "db:seed:admin": "node src/database/seedAdmin.js",
    "import:overture:places": "node src/scripts/importOverturePlaces.js",
    "images:backfill-variants": "node src/scripts/backfillPlaceImageVariants.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {}
}
