# Server
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# Database - native PostgreSQL + PostGIS (no Docker). Replace PASSWORD with
# the password you set for your local postgres user, and make sure the
# hola_maps database exists with the postgis extension enabled (see README).
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/hola_maps

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRES=7d

# CORS - comma separated list of allowed Hola Maps frontend origins
CORS_ORIGIN=http://localhost:5173

# Read-only Public Integration API browser origins (HALO HOLA, etc.).
# Keep this separate from the main app/Admin CORS allowlist.
PUBLIC_API_CORS_ORIGIN=http://localhost:5173
HOLA_MAPS_WEB_URL=http://localhost:5173

# Uploads
# Set these three values in backend/.env to use Cloudinary.
# Backend decides subfolders automatically, for example:
#   <CLOUDINARY_FOLDER>/places
UPLOAD_PROVIDER=local
CLOUDINARY_URL=
CLOUDINARY_FOLDER=hola-maps

# Local fallback + upload validation
UPLOAD_DIR=uploads
MAX_UPLOAD_FILE_SIZE_MB=5
MAX_UPLOAD_FILE_COUNT=20

# Map place viewport cache (per API process)
PLACE_BOUNDS_CACHE_TTL_MS=30000
PLACE_BOUNDS_CACHE_MAX_ENTRIES=400

# Routing
# Public OSRM is suitable for local development. Replace with your own
# routing service before high-traffic production use.
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=10000


# Development admin seed
# Run: npm run db:seed:admin
# The script creates this admin or updates an existing account with the same
# email to role ADMIN. Keep the real password only in backend/.env.
ADMIN_SEED_NAME=Hola Admin
ADMIN_SEED_EMAIL=admin@holamaps.vn
ADMIN_SEED_PASSWORD=replace_with_a_strong_local_password
