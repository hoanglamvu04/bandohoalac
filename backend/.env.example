# Server
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# Database - native PostgreSQL + PostGIS (no Docker). Replace PASSWORD with
# the password you set for your local postgres user, and make sure the
# hola_maps database exists with the postgis extension enabled (see README).
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/hola_maps

# Auth / Security
# Production requires JWT_SECRET and SECURITY_ENCRYPTION_KEY to be 32+ random characters.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=15m
JWT_EXPIRES=15m
REFRESH_TOKEN_DAYS=30
SECURITY_ENCRYPTION_KEY=replace_with_a_different_32_plus_character_random_secret
LOGIN_LOCK_THRESHOLD=8
LOGIN_LOCK_MINUTES=15

# CORS - comma separated list of allowed Hola Maps frontend origins
CORS_ORIGIN=http://localhost:5173

# Read-only Public Integration API browser origins (HALO HOLA, etc.).
# Keep this separate from the main app/Admin CORS allowlist.
PUBLIC_API_CORS_ORIGIN=http://localhost:5173
HOLA_MAPS_WEB_URL=http://localhost:5173

# Uploads
# Set these three values in backend/.env to use Cloudinary.
# Backend decides subfolders automatically, for example:
#   <CLOUDINARY_FOLDER>/places
UPLOAD_PROVIDER=local
CLOUDINARY_URL=
CLOUDINARY_FOLDER=hola-maps

# Local fallback + upload validation
UPLOAD_DIR=uploads
MAX_UPLOAD_FILE_SIZE_MB=5
MAX_UPLOAD_FILE_COUNT=20
MAX_UPLOAD_MEGAPIXELS=40
MAX_UPLOAD_DIMENSION=12000

# Photo Scanner V1
# Wikimedia Commons works without a key. Preferred Foursquare setup:
# Admin -> API & Tích hợp -> Nguồn ngoài. The database-stored encrypted key
# takes priority immediately without restarting PM2. FOURSQUARE_API_KEY below
# remains only as a legacy/local fallback.
# External photos stay remote; Photo Scanner never downloads Google/Foursquare
# files into Hola Maps storage.
FOURSQUARE_API_KEY=
PHOTO_SCAN_REQUEST_TIMEOUT_MS=9000
PHOTO_SCAN_WIKIMEDIA_RADIUS_M=350
PHOTO_SCAN_CANDIDATES_PER_PROVIDER=8
PHOTO_SCAN_MAX_CANDIDATES_PER_PLACE=8

# Auto Ingestion V1
# Enabled by default. Set to false to pause all scheduled collection while
# keeping the Admin -> Auto Ingestion page and manual runs available.
INGESTION_AUTOMATION_ENABLED=true
# Scheduler tick frequency. Actual per-source cadence is stored in data_sources.
INGESTION_SCHEDULER_INTERVAL_MS=300000

# HALO HOLA -> HOLA Maps server-to-server publishing contract.
# Use the exact same secret configured as HOLA_MAPS_HALO_SECRET on HALO HOLA.
# HALO HOLA must send it only in: X-Halo-Hola-Key: <secret>
# Never expose this value through VITE_* or any frontend environment variable.
HOLA_MAPS_HALO_SECRET=replace_with_a_long_random_shared_secret

# Map place viewport cache (per API process)
PLACE_BOUNDS_CACHE_TTL_MS=30000
PLACE_BOUNDS_CACHE_MAX_ENTRIES=400

# Routing
# Public OSRM is suitable for local development. Replace with your own
# routing service before high-traffic production use.
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=10000


# Development admin seed
# Run: npm run db:seed:admin
# The script creates this admin or updates an existing account with the same
# email to role ADMIN. Keep the real password only in backend/.env.
ADMIN_SEED_NAME=Hola Admin
ADMIN_SEED_EMAIL=admin@holamaps.vn
ADMIN_SEED_PASSWORD=replace_with_a_strong_local_password


# Production domain example
# PUBLIC_BASE_URL=https://maps.dothihoalac.vn
# CORS_ORIGIN=https://maps.dothihoalac.vn,https://map.dothihoalac.vn
# PUBLIC_API_CORS_ORIGIN=https://maps.dothihoalac.vn,https://map.dothihoalac.vn
# HOLA_MAPS_WEB_URL=https://maps.dothihoalac.vn
